# SSH / deployment settings for SAT Solutions
#
# Copy this file to `deploy/.env.deploy` and fill in the values.
# `deploy/.env.deploy` is gitignored — NEVER commit real credentials.
#
# Strongly recommended: use SSH key auth (SSH_KEY) instead of a password.
# If you must use password auth, install `sshpass` and set SSH_PASSWORD,
# but prefer rotating to keys as soon as possible.

# Remote host (IP or domain)
SSH_HOST=ahost.uz

# SSH user
SSH_USER=root

# SSH port
SSH_PORT=22

# Path to the private key used for auth (recommended)
SSH_KEY=~/.ssh/id_ed25519

# Password auth fallback (NOT recommended — requires `sshpass`).
# Leave empty when using key auth. Do not commit a real value.
SSH_PASSWORD=

# Absolute path to the app on the remote server
REMOTE_PATH=/var/www/satsolutions

# Git branch to deploy
DEPLOY_BRANCH=master
