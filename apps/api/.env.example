NODE_ENV=development
PORT=4000

# Postgres connection (Sequelize uses it directly)
DATABASE_URL=postgres://satsolutions:satsolutions@localhost:5432/satsolutions

# JWT
JWT_SECRET=change_me_please
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_TTL_DAYS=30

# Public base URL (for building absolute urls if needed)
API_PUBLIC_BASE_URL=http://localhost:4000

# CORS (comma separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Seed admin
SEED_ADMIN_EMAIL=admin@satsolutions.local
SEED_ADMIN_PASSWORD=Admin12345!

