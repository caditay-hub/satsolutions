+// ── Метка рекламного клика из кнопки Telegram на сайте (решение владельца 16.11.2026) ──
+// Посетителю с меткой клика Google Ads сайт подменяет ссылку Telegram на
+// t.me/SAT_zayavki_online_bot?start=g_<код> и кладёт пару «код → метка» в журнал API сайта.
+// По /start g_<код> забираем метку (подпись — тот же mintToken(), что для /admin-chat) и
+// прикладываем её к диалогу tg:<chatId>: дальше leadRef() отдаёт gclid в CRM с первым же
+// сообщением клиента. Код не найден или API недоступен — обращение придёт без метки, как раньше.
+const TG_REF_RE = /^g_([A-Za-z0-9]{8,16})$/;
+async function fetchTgRef(code) {
+  try {
+    const r = await fetch(`${API_INTERNAL_URL}/internal/tg-ref/${code}`, {
+      headers: { Authorization: `Bearer ${mintToken()}` },
+      signal: AbortSignal.timeout(4000), // приветствие не должно ждать зависший запрос
+    });
+    if (r.status === 404) return { notFound: true };
+    if (!r.ok) { console.error("[tg-ref] HTTP", r.status); return null; }
+    return await r.json();
+  } catch (e) { console.error("[tg-ref] запрос не прошёл:", e.message); return null; }
+}
+function attachTgRef(chatId, ref) {
+  if (!ref || !ref.gclid) return false;
+  // mergeMeta проверяет формат метки и не затирает уже записанные метку и страницу
+  mergeMeta(`tg:${chatId}`, { gclid: ref.gclid, page: ref.page || undefined });
+  saveThreads();
+  console.log("[tg-ref] метка клика приложена к диалогу tg:" + chatId);
+  return true;
+}
+// Приветствие для пришедших с кнопки Telegram сайта после рекламного клика вместо карточки
+// компании (тексты и порядок согласованы владельцем 17.11.2026): узбекский и русский вместе,
+// узбекский первым; если Telegram или страница сайта на en / tr / zh — только на этом языке.
+const TG_REF_HELLO = {
+  uz: "Assalomu alaykum! Siz SAT Solutions kompaniyasiga yozdingiz.\nSavolingizni shu yerga yozing — sizga menejer javob beradi.\nIsh vaqti: Du–Ju, 9:00–18:00.",
+  ru: "Здравствуйте! Вы написали в SAT Solutions.\nНапишите ваш вопрос здесь — вам ответит менеджер.\nРаботаем Пн–Пт, 9:00–18:00.",
+  en: "Hello! You have reached SAT Solutions.\nWrite your question here — a manager will reply.\nWorking hours: Mon–Fri, 9:00–18:00 (Tashkent time).",
+  tr: "Merhaba! SAT Solutions'a ulaştınız.\nSorunuzu buraya yazın — yöneticimiz size yanıt verecek.\nÇalışma saatleri: Pzt–Cum, 9:00–18:00 (Taşkent saati).",
+  zh: "您好！这里是 SAT Solutions。\n请在此留言，我们的经理会回复您。\n工作时间：周一至周五 9:00–18:00（塔什干时间）。",
+};
+function tgRefHelloText(tgLang, page) {
+  const t = String(tgLang || "").slice(0, 2).toLowerCase();
+  if (["en", "tr", "zh"].includes(t)) return TG_REF_HELLO[t];
+  const p = (String(page || "").match(/^\/(en|tr|zh)(\/|$)/) || [])[1];
+  if (p) return TG_REF_HELLO[p];
+  return TG_REF_HELLO.uz + "\n\n" + TG_REF_HELLO.ru;
+}
+async function startWithTgRef(msg, code) {
+  const chatId = msg.chat.id;
+  let ref = await fetchTgRef(code);
+  let attached = attachTgRef(chatId, ref); // до приветствия: метка уже на месте, когда человек начнёт писать
+  await bot.sendMessage(chatId, tgRefHelloText(msg.from && msg.from.language_code, ref && ref.page))
+    .catch((e) => console.error("[tg-ref] приветствие:", e.message));
+  // запись уходит с сайта в момент нажатия и могла ещё не дойти — одна повторная попытка
+  if (!attached && ref && ref.notFound) {
+    await new Promise((res) => setTimeout(res, 3000));
+    ref = await fetchTgRef(code);
+    attached = attachTgRef(chatId, ref);
+  }
+  if (!attached) console.log("[tg-ref] код не найден:", code);
+  return attached;
+}
