+// ── Метка рекламного клика из кнопки Telegram на сайте (решение владельца 16.11.2026) ──
+// Посетителю с меткой клика Google Ads сайт подменяет ссылку Telegram на
+// t.me/SAT_zayavki_online_bot?start=g_<код> и кладёт пару «код → метка» в журнал API сайта.
+// По /start g_<код> забираем метку (подпись — тот же mintToken(), что для /admin-chat) и
+// прикладываем её к диалогу tg:<chatId>: дальше leadRef() отдаёт gclid в CRM с первым же
+// сообщением клиента. Кода нет, он не найден или API недоступен — бот работает как раньше.
+const TG_REF_RE = /^g_([A-Za-z0-9]{8,16})$/;
+async function fetchTgRef(code) {
+  try {
+    const r = await fetch(`${API_INTERNAL_URL}/internal/tg-ref/${code}`, {
+      headers: { Authorization: `Bearer ${mintToken()}` },
+    });
+    if (r.status === 404) return { notFound: true };
+    if (!r.ok) { console.error("[tg-ref] HTTP", r.status); return null; }
+    return await r.json();
+  } catch (e) { console.error("[tg-ref] запрос не прошёл:", e.message); return null; }
+}
+async function attachTgRef(chatId, code) {
+  let ref = await fetchTgRef(code);
+  // запись уходит с сайта в момент нажатия и могла ещё не дойти — одна повторная попытка
+  if (ref && ref.notFound) { await new Promise((res) => setTimeout(res, 3000)); ref = await fetchTgRef(code); }
+  if (!ref || !ref.gclid) { console.log("[tg-ref] код не найден:", code); return false; }
+  // mergeMeta проверяет формат метки и не затирает уже записанные метку и страницу
+  mergeMeta(`tg:${chatId}`, { gclid: ref.gclid, page: ref.page || undefined });
+  saveThreads();
+  console.log("[tg-ref] метка клика приложена к диалогу tg:" + chatId);
+  return true;
+}
+
